# ==============================================================================
# Radiation France — Environment Variables
# ==============================================================================

# Application & API
APP_ENV=development
APP_PORT=8000
DATABASE_URL=sqlite:///./data/radiation.db

# Security & Admin Key
ADMIN_API_KEY=change-this-in-production-secure-random-token

# Connectors Configuration
# Source 1: Téléray (ASNR / IRSN) - Official institutional network in France
TELERAY_ENABLED=true
TELERAY_BASE_URL=https://teleray.irsn.fr/api

# Source 2: EURDEP (European Radiological Data Exchange Platform)
EURDEP_ENABLED=false
EURDEP_BASE_URL=https://remap.jrc.ec.europa.eu/api

# Source 3: OpenRadiation (Collaborative citizen network)
OPENRADIATION_ENABLED=false
OPENRADIATION_API_KEY=

# Source 4: Safecast (Global open radiation monitoring)
SAFECAST_ENABLED=false
SAFECAST_BASE_URL=https://api.safecast.org

# Frontend
VITE_API_URL=http://localhost:8000
